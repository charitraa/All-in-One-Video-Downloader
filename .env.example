# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; never commit secrets.
# In production (PythonAnywhere) these can instead be set in the WSGI file.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me

# 1 = development (DEBUG on). Leave unset/0 in production.
DJANGO_DEBUG=0

# Comma-separated hostnames, e.g. youruser.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins allowed to call the API from a browser,
# e.g. https://your-frontend.com
DJANGO_CORS_ALLOWED_ORIGINS=

# Comma-separated trusted origins for CSRF over HTTPS,
# e.g. https://youruser.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Absolute path to the yt-dlp Netscape cookies file.
# Defaults to <project root>/cookies.txt if unset.
DJANGO_COOKIES_FILE=
