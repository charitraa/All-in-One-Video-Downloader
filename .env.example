# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; never commit secrets.
# Settings load this file automatically (python-dotenv); real environment
# variables take precedence over it.
#
# NOTE on hosting: a YouTube downloader needs a residential IP. Free-tier
# PythonAnywhere blocks the required outbound traffic and CANNOT work. The
# recommended setup is a home machine exposed via Cloudflare Tunnel
# (./scripts/serve-tunnel.sh) — see DEPLOY_HOME_TUNNEL.md. The values below
# are pre-filled for that quick-tunnel scenario.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me

# 1 = development (DEBUG on). Leave unset/0 in production.
DJANGO_DEBUG=0

# Comma-separated hostnames. A leading dot is a subdomain wildcard, so
# `.trycloudflare.com` accepts any Cloudflare quick-tunnel URL without edits.
# For a stable named tunnel, use your own hostname instead.
DJANGO_ALLOWED_HOSTS=.trycloudflare.com

# Comma-separated origins allowed to call the API from a browser
# (your deployed frontend), e.g. https://video-master.netlify.app
DJANGO_CORS_ALLOWED_ORIGINS=

# Comma-separated trusted origins for CSRF over HTTPS. A wildcard is allowed
# here (Django 5.x), matching any quick-tunnel subdomain.
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# Absolute path to the yt-dlp Netscape cookies file.
# Defaults to <project root>/cookies.txt if unset.
DJANGO_COOKIES_FILE=

# Optional outbound proxy for yt-dlp. Leave EMPTY when running on a home
# (residential) IP. Only set this to a residential proxy if you are forced to
# run on a datacenter host (VPS/PaaS), where YouTube flags the IP.
YTDLP_PROXY=
